---
/*
 * Hero.astro — the opening pitch, then the chosen app below it: the terminal dashboard
 * or three iPhone screens that follow the Plan → Month → Series cards in Concepts.
 */
import Terminal from "./Terminal.astro";
import Phone from "./Phone.astro";
import AppSwitch from "./AppSwitch.astro";
const repo = "https://github.com/nathanreyes/leeway";

const phones = [
  { screen: "plan", caption: "01 · plan", color: "mauve" },
  { screen: "month", caption: "02 · month", color: "cyan" },
  { screen: "series", caption: "03 · series", color: "green" },
] as const;
---

<section id="top" class="hero">
  <div class="container hero__inner">
    <p class="eyebrow reveal">
      <span data-only="terminal">local-first · terminal · rust</span>
      <span data-only="iphone">local-first · iphone · no account</span>
    </p>

    <h1 class="hero__title reveal" style="animation-delay: 0.06s">
      A budget that answers<br />
      one question: <span class="serif hero__hook">what's left?</span><span class="cursor"></span>
    </h1>

    <div class="hero__switch reveal" style="animation-delay: 0.09s"><AppSwitch /></div>

    <p class="hero__sub reveal" style="animation-delay: 0.12s">
      Leeway forecasts what's left without tracking every transaction: use your
      checking balance as the truth, mark income and bills settled, and watch
      envelopes draw down through the month.
    </p>

    <div class="hero__cta reveal" style="animation-delay: 0.18s">
      <a class="btn btn--primary" href="#install" data-only="terminal">
        Get started <span class="btn__key">curl | sh</span>
      </a>
      <a class="btn" href={repo} target="_blank" rel="noopener" data-only="terminal">View source ↗</a>
      <a class="btn btn--primary" href="#install" data-only="iphone">Coming to the App Store</a>
      <a class="btn" href="#concepts" data-only="iphone">How it works</a>
      <span class="hero__badge">pre-release</span>
    </div>
  </div>

  <div class="container hero__visual">
    <div class="hero__terminal" data-only="terminal"><Terminal /></div>
    <div class="hero__phones" data-only="iphone">
      {phones.map((p, i) => (
        <figure class:list={["hero__phone", "reveal", `hero__phone--${p.screen}`]} style={`animation-delay: ${0.25 + i * 0.08}s`}>
          <Phone screen={p.screen} />
          <figcaption style={`color: var(--${p.color})`}>{p.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .hero { padding: 72px 0 40px; }
  .hero__inner { max-width: 760px; text-align: center; margin-inline: auto; }

  .hero__title {
    font-size: clamp(30px, 5.2vw, 52px);
    line-height: 1.12;
    margin-top: 20px;
  }
  .hero__hook {
    font-size: 1.15em;
    color: var(--mauve);
    font-style: italic;
  }

  .hero__switch { margin-top: 52px; }

  .hero__sub {
    color: var(--dim);
    font-size: clamp(14px, 1.6vw, 16px);
    line-height: 1.7;
    max-width: 60ch;
    margin: 40px auto 0;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 40px;
  }
  .hero__badge {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--amber);
    border: 1px dashed color-mix(in srgb, var(--amber) 55%, transparent);
    border-radius: 999px;
    padding: 4px 12px;
  }

  .hero__visual { display: flex; justify-content: center; margin-top: 72px; }
  .hero__terminal { flex: 1; min-width: 0; }

  /* Three phones, the middle one raised. */
  .hero__phones { display: flex; align-items: flex-start; gap: 32px; }
  .hero__phone { margin: 0; }
  .hero__phone--plan, .hero__phone--series { margin-top: 40px; }
  .hero__phone figcaption {
    margin-top: 18px;
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* Too narrow for three: swipe through them, Month first. */
  @media (max-width: 1000px) {
    :global(html[data-app="iphone"]) .hero__visual { padding-inline: 0; }
    .hero__phones {
      width: 100%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding: 0 24px 24px;
      scrollbar-width: none;
    }
    .hero__phone { scroll-snap-align: center; }
    .hero__phone--plan, .hero__phone--series { margin-top: 0; }
    .hero__phone--month { order: -1; }
  }
</style>
