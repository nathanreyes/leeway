---
/*
 * Features.astro — the capability grid. Copy is drawn straight from README.md
 * so the page makes no claims the app doesn't back up. Each card is a little
 * ratatui panel (bordered box with a title on its top edge).
 *
 * Icons are inline SVG line drawings (not Unicode glyphs — those render as tofu
 * in fonts that lack them). The shared <svg> shell in the template sets stroke =
 * currentColor, so each `icon` below is just the inner geometry.
 */
const features = [
  {
    // disk / local database cylinder
    icon: `<ellipse cx="12" cy="6" rx="7.5" ry="3"/><path d="M4.5 6v12c0 1.7 3.36 3 7.5 3s7.5-1.3 7.5-3V6"/><path d="M4.5 12c0 1.7 3.36 3 7.5 3s7.5-1.3 7.5-3"/>`,
    title: "Local-first",
    body: "Your data stays in a local SQLite file with no account or cloud.",
  },
  {
    // terminal window with a >_ prompt
    icon: `<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M7 9l3 3-3 3"/><path d="M13 15.5h4"/>`,
    title: "Built for the terminal",
    body: "A fast, keyboard-driven Ratatui app centered on what's left.",
  },
  {
    // account / card with a stripe
    icon: `<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3 10h18"/><path d="M6.5 15h5"/>`,
    title: "Accounts at a glance",
    body: "See checking and credit cards in one cash-flow summary.",
  },
  {
    // stacked / duplicated squares (reusable template)
    icon: `<rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>`,
    title: "Reusable plans",
    body: "Stamp reusable plans into independent months without rewriting the past.",
  },
  {
    // envelope
    icon: `<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 7l8.5 6 8.5-6"/>`,
    title: "Envelopes that flow",
    body: "Automatic envelopes release funds over time while manual envelopes track direct spending.",
  },
  {
    // trend line with an arrow tip
    icon: `<path d="M4 15l5-5 4 3 6-7"/><path d="M16 6h3v3"/>`,
    title: "Series & trends",
    body: "Follow items across plans and months as names and amounts change.",
  },
];
---

<section id="features" class="features">
  <div class="container">
    <p class="eyebrow">features</p>
    <h2 class="features__h">Small surface. Serious forecasting.</h2>

    <div class="grid">
      {features.map((f) => (
        <article class="panel card">
          <span class="panel__title">{f.title}</span>
          <div class="card__glyph" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
              set:html={f.icon} />
          </div>
          <p class="card__body">{f.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .features { padding: 64px 0; }
  .features__h {
    font-size: clamp(22px, 3vw, 30px);
    margin: 12px 0 36px;
    max-width: 24ch;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .card {
    padding: 26px 22px 22px;
    transition: border-color 0.18s ease, transform 0.18s ease, background 0.18s ease;
  }
  .card:hover {
    border-color: var(--cyan);       /* echo the app's focused-panel cyan border */
    transform: translateY(-3px);
    background: linear-gradient(180deg, var(--panel-2), var(--panel));
  }
  .card__glyph {
    color: var(--mauve);
    margin-bottom: 14px;
    line-height: 0;
  }
  .card__glyph svg { width: 28px; height: 28px; display: block; }
  .card:hover .card__glyph { color: var(--cyan); }  /* track the hover border */
  .card__body { color: var(--dim); margin: 0; font-size: 14px; }

  @media (max-width: 860px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
